# ==============================================================================
# Severus Desktop App Environment Configuration Example
# Copy this file to .env and fill in your actual keys.
# NEVER commit your actual .env file or API keys to git!
# ==============================================================================

# Voicebox Local AI Voice (jamiepine/voicebox - Optional)
# 100% Local neural voice studio running at http://127.0.0.1:17493
VITE_VOICEBOX_BASE_URL=http://127.0.0.1:17493
VITE_VOICEBOX_PROFILE_ID=default
VITE_VOICEBOX_API_KEY=

# AI Brain & LLM Providers (Optional - can also be configured in UI Settings)
VITE_AI_PROVIDER=
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# Strava Running Telemetry (Optional - can also be configured in UI Settings)
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_CLIENT_SECRET=
VITE_STRAVA_REFRESH_TOKEN=

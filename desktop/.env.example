# ==============================================================================
# Severus Desktop App Environment Configuration Example
# Copy this file to .env and fill in your actual keys.
# NEVER commit your actual .env file or API keys to git!
# ==============================================================================

# ElevenLabs Neural Voice (Optional)
# Free Tier note: ElevenLabs requires Premade Voice IDs on free plans (e.g. George: JBFqnCBsd6RMkjVDRZzb).
# Cloned and Community Library voices require an ElevenLabs Starter subscription.
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
VITE_ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# AI Brain & LLM Providers (Optional - can also be configured in UI Settings)
VITE_AI_PROVIDER=
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# Strava Running Telemetry (Optional - can also be configured in UI Settings)
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_CLIENT_SECRET=
VITE_STRAVA_REFRESH_TOKEN=

# ElevenLabs Neural Voice (Optional - for Severus Snape cloned voice)
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
VITE_ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# AI Brain & LLM Providers (Optional - can also be configured in UI Settings)
VITE_AI_PROVIDER=
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=
